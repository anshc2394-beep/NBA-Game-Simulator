{
  "name": "my-basketball-simulation",
  "version": "1.0.0",
  "description": "A simulation of a basketball game between two teams consisting of NBA players, including player statistics and a self-training model for improved accuracy.",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "ts-node": "^10.0.0",
    "typescript": "^4.0.0",
    "jest": "^27.0.0",
    "@types/jest": "^27.0.0",
    "@types/node": "^16.0.0"
  },
  "devDependencies": {
    "ts-jest": "^27.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "moduleFileExtensions": ["ts", "tsx", "js", "json"]
  },
  "keywords": [
    "basketball",
    "simulation",
    "NBA",
    "game",
    "statistics"
  ],
  "author": "anshc2394-beep",
  "license": "MIT"
}